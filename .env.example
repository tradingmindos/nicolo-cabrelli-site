# Variabili d'ambiente pubbliche (prefisso PUBLIC_): Vite le inlina al build.
# Il sito è statico: i valori vanno impostati ANCHE nelle variabili di build
# di Cloudflare Pages, altrimenti in produzione finiscono undefined nel bundle.

# Secret lato server per la Pages Function del form investitori
# (functions/api/investitori.js). Vive SOLO nelle variabili d'ambiente di
# Cloudflare Pages come Secret: mai nel repo, mai con prefisso PUBLIC_.
RESEND_API_KEY=

# Salt per l'hash SHA-256 degli IP nel rate limit della stessa function
# (64 hex). Anche questo Secret su Cloudflare Pages, mai nel repo.
RATE_LIMIT_SALT=
