# Chiavi pubbliche Supabase per il form waitlist (progetto Trading Mind OS).
# Copia in .env e incolla i valori reali da Supabase → Settings → API.
# Il sito è statico: Vite inlina questi valori al build, quindi vanno impostati
# ANCHE nelle variabili di build di Cloudflare Pages, altrimenti in produzione
# finiscono undefined nel bundle e il form fallisce solo lì.
PUBLIC_SUPABASE_URL=https://TUO-PROGETTO.supabase.co
PUBLIC_SUPABASE_ANON_KEY=INCOLLA-QUI-LA-ANON-KEY
