---
import { i18n, DEFAULT_LANG } from '../i18n/strings';
const t = i18n[DEFAULT_LANG];
---
<section class="section section--ink markets">
  <div class="wrap">
    <p class="eyebrow reveal" data-i18n="eb_mkt" set:html={t.eb_mkt}></p>
    <div class="markets-grid">
      <div class="reveal">
        <h2 data-i18n="mkt_h" set:html={t.mkt_h}></h2>
        <p data-i18n="mkt_p" set:html={t.mkt_p}></p>
      </div>
      <div class="ticker reveal">
        <div class="row"><span data-i18n="tk1" set:html={t.tk1}></span><b>XAU/USD</b></div>
        <div class="row"><span data-i18n="tk2" set:html={t.tk2}></span><b>FX · Indices</b></div>
        <div class="row"><span data-i18n="tk3" set:html={t.tk3}></span><b data-i18n="tk3v" set:html={t.tk3v}></b></div>
        <div class="row"><span data-i18n="tk4" set:html={t.tk4}></span><b>TradingView · MT5</b></div>
      </div>
    </div>
  </div>
</section>
