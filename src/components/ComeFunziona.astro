---
import { home, type HomeLang } from '../i18n/home';

interface Props { lang?: HomeLang }
const { lang = 'it' } = Astro.props;
const t = home[lang];
---
<section class="section">
  <div class="wrap">
    <p class="eyebrow reveal">{t.come.eyebrow}</p>
    <div class="steps">
      {t.come.steps.map((s) => (
        <div class="step reveal">
          <span class="step-n">{s.n}</span>
          <h3>{s.h}</h3>
          <p>{s.p}</p>
        </div>
      ))}
    </div>
  </div>
</section>
