---
import { home, type HomeLang } from '../i18n/home';

interface Props { lang?: HomeLang }
const { lang = 'it' } = Astro.props;
const t = home[lang];
---
<section class="section">
  <div class="wrap">
    <p class="eyebrow reveal">{t.chi.eyebrow}</p>
    <div class="about reveal">
      <div class="about-photo">[FOTO-NICO]</div>
      <p class="about-text">{t.chi.text}</p>
    </div>
  </div>
</section>
