---
import { home, type HomeLang } from '../i18n/home';

interface Props { lang?: HomeLang }
const { lang = 'it' } = Astro.props;
const t = home[lang];
---
<section class="section">
  <div class="wrap">
    <p class="eyebrow reveal">{t.chi.eyebrow}</p>
    <div class="about reveal">
      <img class="about-photo" src="/nico.webp" alt={t.chi.photoAlt} loading="lazy" width="480" height="480" />
      <p class="about-text">{t.chi.text}</p>
    </div>
  </div>
</section>
