---
// Form waitlist — Astro vanilla, zero dipendenze. Insert diretto sull'endpoint
// REST di Supabase con chiave anon pubblica: la RLS lato server è insert-only,
// quindi la chiamata usa Prefer: return=minimal (un return della riga
// richiederebbe una select, negata dalle policy).
// 201 → conferma · 409 (email già in lista) → stessa conferma · altro → errore.
// Honeypot "azienda": se un bot lo compila, l'invio viene simulato e scartato.
import type { HomeLang } from '../i18n/home';

interface Props { locale?: HomeLang }
const { locale = 'it' } = Astro.props;

// Come espressione, mai inline nell'attributo: lì Astro consuma i backslash
// (\s diventerebbe "s") e il pattern rifiuterebbe email valide.
// Rispecchia il check RLS: email like '%_@_%.__%'.
const emailPattern = '[^@\\s]+@[^@\\s]+\\.[^@\\s]{2,}';

const t = {
  it: {
    name: 'Nome',
    email: 'Email',
    submit: 'Iscrivimi',
    sending: 'Invio…',
    ok: 'Registrato. Ti scrivo io.',
    err: 'Qualcosa è andato storto. Riprova tra poco, oppure scrivimi: nicolocabrelli@pm.me',
  },
  en: {
    name: 'Name',
    email: 'Email',
    submit: 'Join',
    sending: 'Sending…',
    ok: "You're on the list. I'll write to you.",
    err: 'Something went wrong. Try again shortly, or email me: nicolocabrelli@pm.me',
  },
}[locale];
---
<form
  class="wl-form"
  data-wl
  data-locale={locale}
  data-ok={t.ok}
  data-err={t.err}
  data-sending={t.sending}
  data-submit={t.submit}
>
  <input type="text" name="name" placeholder={t.name} aria-label={t.name} required maxlength="80" autocomplete="name" />
  <input
    type="email"
    name="email"
    placeholder={t.email}
    aria-label={t.email}
    required
    maxlength="254"
    pattern={emailPattern}
    autocomplete="email"
  />
  <input type="text" name="azienda" class="wl-hp" tabindex="-1" autocomplete="off" aria-hidden="true" />
  <button type="submit" class="btn btn-solid">{t.submit}</button>
  <p class="wl-msg" role="status" hidden></p>
</form>

<script>
  const SUPABASE_URL = import.meta.env.PUBLIC_SUPABASE_URL;
  const SUPABASE_ANON_KEY = import.meta.env.PUBLIC_SUPABASE_ANON_KEY;

  document.querySelectorAll<HTMLFormElement>('form[data-wl]').forEach((form) => {
    const btn = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
    const msg = form.querySelector<HTMLParagraphElement>('.wl-msg')!;

    const show = (text: string, ok: boolean) => {
      msg.textContent = text;
      msg.classList.toggle('wl-msg--ok', ok);
      msg.classList.toggle('wl-msg--err', !ok);
      msg.hidden = false;
    };

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const data = new FormData(form);

      if (data.get('azienda')) {
        form.reset();
        show(form.dataset.ok!, true);
        return;
      }

      btn.disabled = true;
      btn.textContent = form.dataset.sending!;
      msg.hidden = true;

      try {
        const res = await fetch(`${SUPABASE_URL}/rest/v1/waitlist`, {
          method: 'POST',
          headers: {
            apikey: SUPABASE_ANON_KEY,
            Authorization: `Bearer ${SUPABASE_ANON_KEY}`,
            'Content-Type': 'application/json',
            Prefer: 'return=minimal',
          },
          body: JSON.stringify({
            name: data.get('name'),
            email: data.get('email'),
            source: 'tmo',
            locale: form.dataset.locale,
          }),
        });
        if (res.status === 201 || res.status === 409) {
          form.reset();
          show(form.dataset.ok!, true);
        } else {
          show(form.dataset.err!, false);
        }
      } catch {
        show(form.dataset.err!, false);
      }

      btn.disabled = false;
      btn.textContent = form.dataset.submit!;
    });
  });
</script>
