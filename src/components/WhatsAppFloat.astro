---
// Floating WhatsApp bubble (homepage IT + /en/). Not a third-party widget —
// built from our own design tokens. Links to the generic hero message.
import { home, type HomeLang } from '../i18n/home';
import { waHref } from '../lib/site';

interface Props { lang?: HomeLang }
const { lang = 'it' } = Astro.props;
const t = home[lang];
---
<a class="wa-float" href={waHref(t.wa.hero)} target="_blank" rel="noopener" aria-label={t.float.aria}>
  <span class="wa-float__label" id="waFloatLabel" aria-hidden="true">{t.float.label}</span>
  <span class="wa-float__bubble">
    <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2 22l5.25-1.38c1.45.79 3.08 1.21 4.79 1.21h.01c5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01C17.18 3.03 14.69 2 12.04 2zm0 1.8c2.17 0 4.21.85 5.74 2.38a8.06 8.06 0 0 1 2.38 5.73c0 4.47-3.64 8.11-8.12 8.11-1.52 0-3.01-.41-4.3-1.19l-.31-.18-3.12.82.83-3.04-.2-.32a8.05 8.05 0 0 1-1.25-4.3c0-4.47 3.64-8.11 8.11-8.11zm-2.7 4.36c-.18 0-.46.07-.7.34-.24.27-.92.9-.92 2.18 0 1.28.94 2.52 1.07 2.7.13.18 1.85 2.83 4.49 3.97.63.27 1.12.43 1.5.55.63.2 1.2.17 1.66.1.51-.08 1.56-.64 1.78-1.25.22-.61.22-1.14.16-1.25-.07-.11-.24-.18-.51-.31-.27-.13-1.56-.77-1.8-.86-.24-.09-.42-.13-.6.14-.18.27-.69.86-.84 1.04-.16.18-.31.2-.58.07-.27-.14-1.12-.41-2.14-1.32-.79-.7-1.32-1.57-1.48-1.84-.16-.27-.02-.41.12-.55.12-.12.27-.31.4-.47.13-.16.18-.27.27-.45.09-.18.04-.34-.02-.47-.07-.14-.6-1.45-.84-1.98-.22-.52-.44-.45-.6-.46h-.51z"/></svg>
  </span>
</a>

<style>
  .wa-float{
    position:fixed;bottom:24px;right:24px;z-index:90;
    display:block;line-height:0;
  }
  .wa-float__bubble{
    width:56px;height:56px;border-radius:50%;
    background:var(--bordeaux);color:var(--light-fixed);
    display:flex;align-items:center;justify-content:center;
    box-shadow:0 6px 20px rgba(14,14,15,.22);
    transition:background .2s ease,transform .2s ease;
  }
  .wa-float:hover .wa-float__bubble{background:#651825;transform:translateY(-2px);}
  .wa-float__bubble svg{width:30px;height:30px;display:block;}

  /* label pill, anchored to the left of the bubble so it never grows the hit area */
  .wa-float__label{
    position:absolute;right:68px;top:50%;
    transform:translateY(-50%) translateX(8px);
    background:var(--cream-2);color:var(--ink);border:1px solid var(--rule);
    font-family:var(--mono);font-size:13px;letter-spacing:.02em;line-height:1;
    padding:9px 14px;border-radius:999px;white-space:nowrap;pointer-events:none;
    box-shadow:0 6px 20px rgba(14,14,15,.16);
    opacity:0;transition:opacity .3s ease,transform .3s ease;
  }
  .wa-float__label.is-shown{opacity:1;transform:translateY(-50%);}

  @media(max-width:760px){
    .wa-float{bottom:16px;right:16px;}
    .wa-float__bubble{width:52px;height:52px;}
    .wa-float__bubble svg{width:28px;height:28px;}
    .wa-float__label{right:64px;}
    /* keep the bubble clear of the footer's last line on small screens */
    :global(footer){padding-bottom:88px;}
  }

  @media(prefers-reduced-motion:reduce){
    .wa-float__bubble,.wa-float__label{transition:none;}
    .wa-float__label{opacity:1;transform:translateY(-50%);}
  }
</style>

<script>
  // Reveal the label after 3s; hide on first scroll or after 8s.
  // With reduced motion, CSS already shows it immediately and we do nothing.
  const label = document.getElementById('waFloatLabel');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (label && !reduce) {
    window.setTimeout(() => {
      label.classList.add('is-shown');
      const hideTimer = window.setTimeout(() => label.classList.remove('is-shown'), 8000);
      window.addEventListener(
        'scroll',
        () => { label.classList.remove('is-shown'); window.clearTimeout(hideTimer); },
        { once: true, passive: true },
      );
    }, 3000);
  }
</script>
