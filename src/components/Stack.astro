---
import { i18n, DEFAULT_LANG } from '../i18n/strings';
const t = i18n[DEFAULT_LANG];
---
<section class="section section--ink">
  <div class="wrap">
    <p class="eyebrow reveal" data-i18n="eb_stack" set:html={t.eb_stack}></p>
    <div class="stack-grid reveal">
      <div class="stack-cell"><span class="idx">01</span>JavaScript</div>
      <div class="stack-cell"><span class="idx">02</span>React</div>
      <div class="stack-cell"><span class="idx">03</span>Vite</div>
      <div class="stack-cell"><span class="idx">04</span>Node.js</div>
      <div class="stack-cell"><span class="idx">05</span>Supabase</div>
      <div class="stack-cell"><span class="idx">06</span>PostgreSQL</div>
      <div class="stack-cell"><span class="idx">07</span>Cloudflare</div>
      <div class="stack-cell"><span class="idx">08</span>REST APIs</div>
      <div class="stack-cell"><span class="idx">09</span>Astro</div>
      <div class="stack-cell"><span class="idx">10</span>Tailwind</div>
      <div class="stack-cell"><span class="idx">11</span>Git</div>
      <div class="stack-cell"><span class="idx">12</span>Anthropic API</div>
    </div>
  </div>
</section>
