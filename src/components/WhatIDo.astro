---
// Homepage Services section. Each card links to its own prefilled WhatsApp message.
import { home, type HomeLang } from '../i18n/home';
import { waHref } from '../lib/site';

interface Props { lang?: HomeLang }
const { lang = 'it' } = Astro.props;
const t = home[lang];
---
<section class="section">
  <div class="wrap">
    <p class="eyebrow reveal">{t.servizi.eyebrow}</p>
    <div class="stanzas">
      {t.servizi.cards.map((c) => (
        <div class="stanza reveal">
          <span class="k">{c.k}</span>
          <h3>{c.h}</h3>
          <p>{c.p}</p>
          <a class="svc-msg" href={waHref(t.wa[c.wa])} target="_blank" rel="noopener">{t.servizi.msgLink}</a>
        </div>
      ))}
    </div>
  </div>
</section>
