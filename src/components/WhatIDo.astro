---
import { i18n, DEFAULT_LANG } from '../i18n/strings';
const t = i18n[DEFAULT_LANG];
---
<section class="section">
  <div class="wrap">
    <p class="eyebrow reveal" data-i18n="eb_do" set:html={t.eb_do}></p>
    <div class="stanzas">
      <div class="stanza reveal">
        <span class="k" data-i18n="do1_k" set:html={t.do1_k}></span>
        <h3 data-i18n="do1_h" set:html={t.do1_h}></h3>
        <p data-i18n="do1_p" set:html={t.do1_p}></p>
      </div>
      <div class="stanza reveal">
        <span class="k" data-i18n="do2_k" set:html={t.do2_k}></span>
        <h3 data-i18n="do2_h" set:html={t.do2_h}></h3>
        <p data-i18n="do2_p" set:html={t.do2_p}></p>
      </div>
      <div class="stanza reveal">
        <span class="k" data-i18n="do3_k" set:html={t.do3_k}></span>
        <h3 data-i18n="do3_h" set:html={t.do3_h}></h3>
        <p data-i18n="do3_p" set:html={t.do3_p}></p>
      </div>
    </div>
  </div>
</section>
