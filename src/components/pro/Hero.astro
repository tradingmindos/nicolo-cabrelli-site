---
import { EMAIL, LINKEDIN, GITHUB } from '../../lib/site';
---
<header class="hero">
  <div class="wrap">
    <h1>Nicolò<br>Cabrelli</h1>
    <div class="roles">Full-stack developer&nbsp;·&nbsp;<b>Solo founder</b></div>

    <svg class="price-line" viewBox="0 0 560 46" aria-hidden="true" preserveAspectRatio="none">
      <path d="M0 34 L70 30 L120 36 L170 22 L230 27 L300 12 L360 20 L420 8 L490 16 L560 4" />
      <circle class="n1" cx="300" cy="12" r="3.4" />
      <circle class="n2" cx="560" cy="4" r="3.4" />
    </svg>

    <div class="status">
      <span>Available for freelance projects</span><span class="dot">·</span>
      <span>Remote</span>
    </div>

    <p class="lede">I’m a self-taught full-stack developer. I design, build and ship web products end to end — from database to interface — and I’ve launched a live SaaS on my own.</p>

    <div class="hero-links">
      <a class="btn btn--primary" href={`mailto:${EMAIL}`}>Email me</a>
      <a class="btn" href={LINKEDIN} target="_blank" rel="noopener">LinkedIn ↗</a>
      <a class="btn" href={GITHUB} target="_blank" rel="noopener">GitHub ↗</a>
    </div>
  </div>
</header>
