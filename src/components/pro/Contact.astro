---
import { EMAIL, LINKEDIN, GITHUB } from '../../lib/site';
---
<section class="section contact">
  <div class="wrap">
    <p class="eyebrow reveal">Get in touch</p>
    <h2 class="reveal">Let’s talk.</h2>
    <p class="reveal">Open to remote full-stack roles and freelance projects. The fastest way to reach me is email or LinkedIn.</p>
    <div class="contact-links reveal">
      <a class="clink" href={`mailto:${EMAIL}`}>{EMAIL}</a>
      <a class="clink" href={LINKEDIN} target="_blank" rel="noopener">LinkedIn ↗</a>
      <a class="clink" href={GITHUB} target="_blank" rel="noopener">GitHub ↗</a>
    </div>
  </div>
</section>
