---
import { home, type HomeLang } from '../i18n/home';
import { waHref } from '../lib/site';

interface Props { lang?: HomeLang }
const { lang = 'it' } = Astro.props;
const t = home[lang];
---
<header class="hero">
  <div class="wrap">
    <h1>{t.hero.h1a}<br>{t.hero.h1b}</h1>
    <p class="hero-sub">{t.hero.sub}</p>

    <svg class="price-line" viewBox="0 0 560 46" aria-hidden="true" preserveAspectRatio="none">
      <path d="M0 34 L70 30 L120 36 L170 22 L230 27 L300 12 L360 20 L420 8 L490 16 L560 4" />
      <circle class="n1" cx="300" cy="12" r="3.4" />
      <circle class="n2" cx="560" cy="4" r="3.4" />
    </svg>

    <div class="hero-links">
      <a class="btn btn--wa" href={waHref(t.wa.hero)} target="_blank" rel="noopener">
        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2 22l5.25-1.38c1.45.79 3.08 1.21 4.79 1.21h.01c5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01C17.18 3.03 14.69 2 12.04 2zm0 1.8c2.17 0 4.21.85 5.74 2.38a8.06 8.06 0 0 1 2.38 5.73c0 4.47-3.64 8.11-8.12 8.11-1.52 0-3.01-.41-4.3-1.19l-.31-.18-3.12.82.83-3.04-.2-.32a8.05 8.05 0 0 1-1.25-4.3c0-4.47 3.64-8.11 8.11-8.11zm-2.7 4.36c-.18 0-.46.07-.7.34-.24.27-.92.9-.92 2.18 0 1.28.94 2.52 1.07 2.7.13.18 1.85 2.83 4.49 3.97.63.27 1.12.43 1.5.55.63.2 1.2.17 1.66.1.51-.08 1.56-.64 1.78-1.25.22-.61.22-1.14.16-1.25-.07-.11-.24-.18-.51-.31-.27-.13-1.56-.77-1.8-.86-.24-.09-.42-.13-.6.14-.18.27-.69.86-.84 1.04-.16.18-.31.2-.58.07-.27-.14-1.12-.41-2.14-1.32-.79-.7-1.32-1.57-1.48-1.84-.16-.27-.02-.41.12-.55.12-.12.27-.31.4-.47.13-.16.18-.27.27-.45.09-.18.04-.34-.02-.47-.07-.14-.6-1.45-.84-1.98-.22-.52-.44-.45-.6-.46h-.51z"/></svg>
        {t.hero.cta}
      </a>
    </div>
    <p class="hero-note">{t.hero.note}</p>
  </div>
</header>
