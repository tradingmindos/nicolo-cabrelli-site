---
import { home, type HomeLang } from '../i18n/home';

interface Props { lang?: HomeLang }
const { lang = 'it' } = Astro.props;
const t = home[lang];
---
<section class="section">
  <div class="wrap">
    <p class="eyebrow reveal">{t.caso.eyebrow}</p>

    <article class="project project--case reveal">
      <img class="case-media" src="/case-taxi.svg" alt={t.caso.mediaAlt} loading="lazy" width="800" height="450" />
      <div class="ptop">
        <h3><a href="https://taxi-pontremoli.com" target="_blank" rel="noopener">Taxi Pontremoli ↗</a></h3>
        <span class="tag tag--live">{t.caso.taxiTag}</span>
      </div>
      <p>{t.caso.taxiP}</p>
      {t.caso.quote && <blockquote class="quote">{t.caso.quote}</blockquote>}
    </article>

    <article class="project reveal">
      <div class="ptop">
        <h3><a href="https://tradingmindos.com" target="_blank" rel="noopener">Trading Mind OS ↗</a></h3>
        <span class="tag">{t.caso.tmoTag}</span>
      </div>
      <p>{t.caso.tmoP}</p>
    </article>
  </div>
</section>
