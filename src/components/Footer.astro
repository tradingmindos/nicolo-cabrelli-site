---
import { LINKEDIN, GITHUB, VAT } from '../lib/site';
import type { HomeLang } from '../i18n/home';

// Footer carries no translatable copy (legal line + social links are
// language-neutral); the lang prop is accepted for interface consistency.
interface Props { lang?: HomeLang }
const { lang: _lang = 'it' } = Astro.props;
---
<footer>
  <div class="wrap">
    <span>© 2026 Nicolò Cabrelli · C.F. {VAT}</span>
    <span class="foot-links">
      <a href={LINKEDIN} target="_blank" rel="noopener">LinkedIn</a>
      <a href={GITHUB} target="_blank" rel="noopener">GitHub</a>
    </span>
  </div>
</footer>
