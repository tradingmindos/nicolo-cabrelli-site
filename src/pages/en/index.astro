---
import LayoutRedesign from '../../layouts/LayoutRedesign.astro';
import { SITE_URL, LINKEDIN, GITHUB } from '../../lib/site';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Nicolò Cabrelli',
  jobTitle: 'Full-stack developer',
  url: SITE_URL,
  sameAs: [GITHUB, LINKEDIN],
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Pontremoli',
    addressRegion: 'Tuscany',
    addressCountry: 'IT',
  },
};
---
<LayoutRedesign
  lang="en"
  title="Nicolò Cabrelli — Full-stack developer · Solo founder"
  description="I design, build and ship complete web products — from database to interface. Two SaaS platforms live, built solo. Available for freelance projects and remote roles."
  ogDescription="Complete web products, from database to interface. Two SaaS platforms live, built solo."
  jsonLd={jsonLd}
  alternates={[
    { hreflang: 'it', href: `${SITE_URL}/` },
    { hreflang: 'en', href: `${SITE_URL}/en/` },
  ]}
>
<header class="top">
  <div class="wrap top-inner">
    <a class="logo" href="/en/"><b>nc</b>.cabrelli</a>
    <nav class="main" aria-label="Main navigation">
      <a href="#work">work</a>
      <a href="#method" class="hide-m">method</a>
      <a href="#profile" class="hide-m">profile</a>
      <a href="#contact">contact</a>
      <a class="lang" href="/" hreflang="it" aria-label="Passa all'italiano">it / <b>en</b></a>
    </nav>
  </div>
</header>

<main>

<div class="hero">
  <div class="wrap">
    <p class="eyebrow">pontremoli, italy · available for remote work</p>
    <h1>I build <em>complete</em> web products. Solo.</h1>
    <p class="sub">I'm Nicolò Cabrelli, a self-taught full-stack developer and solo founder. I design the system, write the code, ship it to production and keep it running — from database to interface, from first commit to live domain.</p>
    <div class="cta-row">
      <a class="btn btn-solid" href="mailto:info@nicolocabrelli.com">Email me</a>
      <a class="btn btn-ghost" href="https://github.com/tradingmindos" rel="noopener">GitHub ↗</a>
      <a class="btn btn-ghost" href="https://www.linkedin.com/in/nicolocabrelli-tradingmindos" rel="noopener">LinkedIn ↗</a>
    </div>
    <div class="hero-facts">
      <span><b>2</b> SaaS platforms in production</span>
      <span><b>end-to-end</b> — design → deploy</span>
      <span><b>it / en</b></span>
    </div>
  </div>
</div>

<section id="work">
  <div class="wrap">
    <p class="sec-label"><b>selected</b> work</p>

    <article class="dossier dossier--min fade">
      <div class="d-body">
        <h3><a href="/en/progetti/trading-mind-os">Trading Mind OS</a></h3>
        <p class="lead">Trading psychology platform. Own product, active development.</p>
        <div class="stack-tags">
          <span>react</span><span>vite</span><span>supabase</span><span>postgresql</span><span>cloudflare</span><span>anthropic api</span><span>metatrader 5</span>
        </div>
        <a class="d-link" href="/en/progetti/trading-mind-os">View project →</a>
      </div>
    </article>

    <article class="dossier dossier--min fade">
      <div class="d-body">
        <span class="status">live</span>
        <h3><a href="https://soravent.com" rel="noopener">SORAVENT <span class="ext">↗</span></a></h3>
        <p class="lead">A premium Italian-language trading education platform.</p>
        <div class="stack-tags">
          <span>react</span><span>supabase</span><span>postgresql</span><span>cloudflare</span><span>pdf generation</span>
        </div>
        <a class="d-link" href="https://soravent.com" rel="noopener">soravent.com ↗</a>
      </div>
    </article>

    <article class="dossier dossier--min fade">
      <div class="d-body">
        <span class="status">live</span>
        <h3><a href="https://taxi-pontremoli.com" rel="noopener">Taxi Pontremoli <span class="ext">↗</span></a></h3>
        <p class="lead">A production website for a local business: fast, optimized for Google, delivered end-to-end.</p>
        <div class="stack-tags">
          <span>astro</span><span>tailwind</span><span>cloudflare pages</span><span>technical seo</span>
        </div>
        <a class="d-link" href="https://taxi-pontremoli.com" rel="noopener">taxi-pontremoli.com ↗</a>
      </div>
    </article>

  </div>
</section>

<section id="method">
  <div class="wrap">
    <p class="sec-label"><b>method</b> — how I work</p>
    <div class="method fade">
      <article>
        <h4>Product <span>design → ship</span></h4>
        <p>I start from the problem, not the stack. I design the system, define the smallest scope that creates value, and put it online. One product in production beats ten prototypes.</p>
        <p class="tools">design in code · iteration on real users</p>
      </article>
      <article>
        <h4>Engineering <span>frontend + backend</span></h4>
        <p>React and Astro on the interface, Postgres and Supabase on the data, with row-level security and server-enforced logic. I integrate external APIs where they earn their place — AI included.</p>
        <p class="tools">react · vite · astro · supabase · postgresql · node · rest api · anthropic api</p>
      </article>
      <article>
        <h4>Operations <span>deploy → maintain</span></h4>
        <p>Cloudflare deploys, DNS, security, analytics, technical SEO. Launch isn't the finish line: I verify in production, measure, and fix.</p>
        <p class="tools">cloudflare pages · git · 2fa everywhere · web analytics</p>
      </article>
    </div>
  </div>
</section>

<section id="profile">
  <div class="wrap">
    <p class="sec-label"><b>profile</b></p>
    <div class="profile fade">
      <div class="txt">
        <p><b>Self-taught by necessity, systematic by choice.</b> I learned to code by building real products, with real users and real problems — not by following tutorials. Every project on this page went through my hands in every part: database schema, interface, security, deploy, domain.</p>
        <p>I live in Pontremoli, in Lunigiana, Tuscany, and I work remotely. This place taught me something I carry into code: things built well last, and the person who built them answers for them. If you need a change a year from now, you know who to call.</p>
        <p>I'm open to <b>freelance projects and remote full-stack roles</b>.</p>
      </div>
      <figure>
        <img src="/nico.webp" alt="Nicolò Cabrelli" width="240" height="240" loading="lazy">
        <figcaption>pontremoli, lunigiana — 44.37° n, 9.88° e</figcaption>
      </figure>
    </div>
  </div>
</section>

<section id="contact" class="contact">
  <div class="wrap fade">
    <p class="sec-label"><b>contact</b></p>
    <h2>Have a system to build? <em>Let's talk.</em></h2>
    <div class="cta-row">
      <a class="btn btn-solid" href="mailto:info@nicolocabrelli.com">I have a project</a>
      <a class="btn btn-ghost" href="/en/investitori">I'm an investor</a>
    </div>
    <div class="links">
      <a href="https://github.com/tradingmindos" rel="noopener">GitHub ↗</a>
      <a href="https://www.linkedin.com/in/nicolocabrelli-tradingmindos" rel="noopener">LinkedIn ↗</a>
    </div>
  </div>
</section>

</main>

<footer>
  <div class="wrap foot">
    <span>© 2026 Nicolò Cabrelli · C.F. 90021180451</span>
    <span class="foot-nav">
      <a href="/en/progetti">Projects</a>
      <a href="/en/investitori">Investors</a>
      <a href="/en/lunigiana">Websites for local businesses in Lunigiana →</a>
    </span>
  </div>
</footer>
</LayoutRedesign>
