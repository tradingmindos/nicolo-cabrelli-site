---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Nicolò Cabrelli — Full-stack developer, founder, trader',
  description = 'Self-taught full-stack developer and solo founder. I build software end-to-end and trade the markets I build it for.',
} = Astro.props;
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600;700&family=Hanken+Grotesk:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />

  <!-- Anti-FOUC: apply saved theme + lang before first paint, synchronously. -->
  <script is:inline>
    (function () {
      try {
        if (localStorage.getItem('theme') === 'dark') {
          document.documentElement.setAttribute('data-theme', 'dark');
        }
        var l = localStorage.getItem('lang');
        if (l === 'it' || l === 'en') document.documentElement.lang = l;
      } catch (e) {}
    })();
  </script>
</head>
<body>
  <slot />

  <script>
    import { i18n, DEFAULT_LANG, type Lang } from '../i18n/strings';

    function getStoredLang(): Lang {
      try {
        const l = localStorage.getItem('lang');
        if (l === 'it' || l === 'en') return l;
      } catch (e) {}
      return DEFAULT_LANG;
    }

    function applyLang(lang: Lang) {
      const dict = i18n[lang] as Record<string, string>;
      document.documentElement.lang = lang;
      document.querySelectorAll('[data-i18n]').forEach((el) => {
        const key = el.getAttribute('data-i18n');
        if (key && dict[key] !== undefined) el.innerHTML = dict[key];
      });
      document.querySelectorAll<HTMLButtonElement>('.lang button').forEach((b) => {
        b.classList.toggle('active', b.dataset.lang === lang);
      });
    }

    document.querySelectorAll<HTMLButtonElement>('.lang button').forEach((b) => {
      b.addEventListener('click', () => {
        const lang = (b.dataset.lang === 'it' ? 'it' : 'en') as Lang;
        try { localStorage.setItem('lang', lang); } catch (e) {}
        applyLang(lang);
      });
    });

    applyLang(getStoredLang());

    // theme toggle (light / dark) — persisted, default light
    const themeBtn = document.getElementById('themeBtn');
    let theme: 'light' | 'dark' = 'light';
    try { if (localStorage.getItem('theme') === 'dark') theme = 'dark'; } catch (e) {}

    function applyTheme(t: 'light' | 'dark') {
      if (t === 'dark') document.documentElement.setAttribute('data-theme', 'dark');
      else document.documentElement.removeAttribute('data-theme');
      themeBtn?.setAttribute('aria-pressed', String(t === 'dark'));
    }
    applyTheme(theme); // sync aria-pressed with the theme set by the inline script

    themeBtn?.addEventListener('click', () => {
      theme = theme === 'dark' ? 'light' : 'dark';
      try { localStorage.setItem('theme', theme); } catch (e) {}
      applyTheme(theme);
    });

    // scroll reveal
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (!reduce && 'IntersectionObserver' in window) {
      const io = new IntersectionObserver((entries) => {
        entries.forEach((e) => {
          if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); }
        });
      }, { threshold: 0.12 });
      document.querySelectorAll('.reveal').forEach((el) => io.observe(el));
    } else {
      document.querySelectorAll('.reveal').forEach((el) => el.classList.add('in'));
    }
  </script>
</body>
</html>
